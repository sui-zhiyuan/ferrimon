{
  "name": "ferrimon-view",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web-app/vite.config.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --config web-app/vite.config.ts",
    "test:unit": "vitest --config web-app/vitest.config.ts",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test 'vite preview --config web-app/vite.config.ts' http://localhost:4173 'cypress run --e2e --config-file web-app/cypress.config.ts'",
    "test:e2e:dev": "start-server-and-test 'vite dev --config web-app/vite.config.ts --port 4173' http://localhost:4173 'cypress open --e2e --config-file web-app/cypress.config.ts'",
    "build-only": "vite build --config web-app/vite.config.ts",
    "type-check": "vue-tsc --build web-app/tsconfig.json",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint web-app --fix --config web-app/.oxlintrc.json",
    "lint:eslint": "eslint web-app --config web-app/eslint.config.ts --fix --cache --cache-location target/web-app/eslintcache",
    "format": "oxfmt --config web-app/.oxfmtrc.json web-app/src/"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^15.14.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.3.1",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.45.0",
    "oxlint": "~1.60.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
